BMKG_PORT=8081
BMKG_API_KEY=bmkg-demo-key
BMKG_DELAY_MS=100
BMKG_SEED_COUNT=20
BMKG_GENERATION_INTERVAL_SECONDS=10
BMKG_RANDOM_SEED=4031

PVMBG_PORT=8082
PVMBG_TOKEN=pvmbg-demo-token
PVMBG_DELAY_MIN_MS=500
PVMBG_DELAY_MAX_MS=3000
PVMBG_SEED_COUNT=20
PVMBG_GENERATION_INTERVAL_SECONDS=10
PVMBG_RANDOM_SEED=4031

AUTH_PORT=8091
# generate: openssl rand -base64 32  (wajib diganti, jangan commit nilai asli)
AUTH_SIGNING_SEED=CHANGE_ME_openssl_rand_base64_32
AUTH_INTERNAL_KEY=auth-internal-demo-key
AUTH_ACCESS_TTL_SECONDS=60
AUTH_REFRESH_TTL_SECONDS=600

AUTH_CLIENT_MEDIA_ID=media-demo
AUTH_CLIENT_MEDIA_SECRET=media-demo-secret
AUTH_CLIENT_FIELD_ID=field-demo
AUTH_CLIENT_FIELD_SECRET=field-demo-secret
AUTH_CLIENT_OPS_ID=ops-demo
AUTH_CLIENT_OPS_SECRET=ops-demo-secret

CLIENT_API_PORT=8080
AGGREGATOR_API_KEY=aggregator-internal-demo-key
CLIENT_API_AGGREGATOR_TIMEOUT_MS=1500
CLIENT_API_MAX_INFLIGHT=200
CLIENT_API_REVOCATION_POLL_MS=250

NOTIFIER_QUEUE=notifier-queue
NOTIFIER_BINDING_KEYS=hazard.#
NOTIFIER_MIN_SEVERITY=WASPADA
NOTIFIER_PROCESS_DELAY_MS=0
NOTIFIER_HEALTH_PORT=8093

# kredensial root Mongo (Canonical Store, hanya dijangkau aggregator). Pakai karakter alfanumerik.
MONGO_ROOT_USERNAME=bnpb
MONGO_ROOT_PASSWORD=change-me-mongo
MONGO_DB_NAME=bnpb_canonical
MONGO_HAZARD_COLLECTION=hazard_events

# kredensial broker; URL amqp dirakit oleh docker-compose. Pakai karakter alfanumerik.
RABBITMQ_USER=bnpb
RABBITMQ_PASSWORD=change-me-rabbit
RABBITMQ_EXCHANGE=hazard_events
RABBITMQ_EXCHANGE_TYPE=topic

AGGREGATOR_PORT=8090
AGGREGATOR_POLL_INTERVAL_SECONDS=5
AGGREGATOR_BMKG_TIMEOUT_MS=2000
AGGREGATOR_PVMBG_TIMEOUT_MS=4000
AGGREGATOR_PVMBG_STALE_AFTER_SECONDS=30

DASHBOARD_UPDATER_QUEUE=dashboard-updater-queue
DASHBOARD_UPDATER_PREFETCH=10
DASHBOARD_UPDATER_HEALTH_PORT=8092
