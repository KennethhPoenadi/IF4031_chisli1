PVMBG_FIELD_ALIASES=
PVMBG_FIELD_COERCE=
DLQ_RETRY_INTERVAL_SECONDS=5
FIELD_REPORT_PROCESS_DELAY_MS=0
FIELD_REPORT_PUBLISH_TIMEOUT_MS=2000
# true: endpoint admin mock dapat dipanggil Tester Agent tanpa PVMBG_TOKEN
PVMBG_ADMIN_TESTER_COMPAT=false

